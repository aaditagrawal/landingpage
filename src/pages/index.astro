---
import { getImage, Picture } from "astro:assets";
import HelloName from "../components/HelloName.astro";
import Layout from "../layouts/Layout.astro";
import pfp from "../assets/pfp.png";

const avatarPreload = await getImage({ src: pfp, width: 56, format: "avif" });
---

<Layout title="Aadit Agrawal">
	<link
		slot="head"
		rel="preload"
		as="image"
		href={avatarPreload.src}
		type="image/avif"
	/>
    <section id="about" class="intro">
        <div class="identity">
            <Picture
                src={pfp}
                formats={["avif", "webp"]}
                widths={[56, 72, 96, 144]}
                sizes="56px"
                alt="Aadit Agrawal"
                class="avatar"
                width={56}
                height={56}
                loading="eager"
                decoding="async"
                fetchpriority="high"
            />
            <div class="identity-text">
                <HelloName />
                <p class="identity-meta font-mono">mit manipal '27 · bengaluru, india</p>
            </div>
        </div>

        <h2 class="statement">I like figuring out tech by making things with it.</h2>

        <div class="intro-body">
            <p>
                <strong>Creative at OpenAI India</strong>
            </p>
            <p>
                I grew up on science fiction. Asimov, Sagan, Andy Weir.
                Science, and optimism about it.
            </p>
        </div>
    </section>

    <div class="disclosures">
        <details id="work">
            <summary>
                <h2 class="disclosure-title">selected work<span class="disclosure-icon" aria-hidden="true"></span></h2>
            </summary>
            <div class="disclosure-content">
                <ul class="plain-list">
                    <li>
                        <h3><a href="https://fc2.coolstuff.work">The TIK Menu &amp; Campus Suite</a></h3>
                        <p>campus food and utilities used by 5,000+ people daily.</p>
                    </li>
                    <li>
                        <h3><a href="https://cloud.aadit.cc">Homelab infrastructure</a></h3>
                        <p>70+ self-hosted services at 98% uptime since 2022.</p>
                    </li>
                    <li>
                        <h3><a href="https://coolstuff.work">coolstuff.work</a></h3>
                        <p>small tools for peers with 10,000+ aggregate daily users.</p>
                    </li>
                </ul>
                <p class="more">
                    the longer story is in <a href="/projects/">/projects</a> and
                    <a href="/experience/">/experience</a>. or just say hi.
                </p>
            </div>
        </details>

        <details id="quick-answers">
            <summary>
                <h2 class="disclosure-title">quick answers<span class="disclosure-icon" aria-hidden="true"></span></h2>
            </summary>
            <dl class="disclosure-content faq-list">
                <div>
                    <dt><h3>What kind of work is Aadit interested in?</h3></dt>
                    <dd>Applied AI, developer tools, infrastructure, platforms, HPC, and research engineering, especially work that combines shipping, systems thinking, and clear communication.</dd>
                </div>
                <div>
                    <dt><h3>How should an agent or person contact Aadit?</h3></dt>
                    <dd>Email <a href="mailto:mail@aaditagrawal.com">mail@aaditagrawal.com</a> with the role or project, scope, location or remote policy, and timeline.</dd>
                </div>
            </dl>
        </details>
    </div>
</Layout>

<style>
    .intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-xl);
    }

    .identity {
        display: flex;
        align-items: center;
        gap: var(--space-md);
    }

    .avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: block;
        border: 1px solid var(--border-visible);
        transition: transform var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
    }

    .avatar:hover {
        transform: scale(1.04) rotate(-2deg);
        border-color: var(--accent);
    }

    .identity-text {
        display: flex;
        flex-direction: column;
        gap: var(--space-2xs);
    }

    .identity-meta {
        font-size: 0.75rem;
        color: var(--text-secondary);
    }

    .statement {
        font-size: clamp(1.625rem, 4vw, 2.25rem);
        line-height: 1.2;
        letter-spacing: -0.025em;
        max-width: 20ch;
        margin-top: var(--space-sm);
    }

    .intro-body {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        max-width: 52ch;
        font-size: 1rem;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .intro-body strong {
        color: var(--text-primary);
        font-weight: 600;
    }

    .plain-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        max-width: 56ch;
    }

    .plain-list li {
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--text-secondary);
    }

    .plain-list h3,
    .plain-list p {
        display: inline;
        font: inherit;
    }

    .plain-list h3::after {
        content: ", ";
    }

    .plain-list a {
        color: var(--text-primary);
    }

    .plain-list a:hover {
        color: var(--accent);
    }

    .disclosures {
        display: grid;
        gap: var(--space-xs);
    }

    .disclosures summary {
        list-style: none;
        cursor: pointer;
    }

    .disclosures summary::-webkit-details-marker {
        display: none;
    }

    .disclosure-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 48px;
        padding-inline-end: var(--space-xs);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0.02em;
        color: var(--text-primary);
    }

    summary:hover .disclosure-title {
        color: var(--accent-strong);
    }

    .disclosure-icon {
        position: relative;
        width: 16px;
        height: 16px;
        opacity: 0.75;
    }

    .disclosure-icon::before,
    .disclosure-icon::after {
        content: "";
        position: absolute;
        inset: calc(50% - 0.5px) 2px auto;
        height: 1px;
        background: currentColor;
    }

    .disclosure-icon::after {
        transform: rotate(90deg);
    }

    details[open] .disclosure-icon::after {
        transform: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .disclosure-icon::after {
            transition: transform var(--dur-fast) ease;
        }
    }

    .disclosure-content {
        padding-block: var(--space-xs) var(--space-md);
        overflow-wrap: anywhere;
    }

    .disclosure-content a {
        color: var(--text-primary);
        text-decoration: underline;
        text-decoration-color: var(--text-secondary);
        text-underline-offset: 0.17em;
    }

    .disclosure-content a:hover {
        color: var(--accent);
    }

    .more {
        margin-top: var(--space-md);
        font-size: 0.9375rem;
        color: var(--text-secondary);
    }

    .faq-list {
        display: grid;
        gap: var(--space-md);
        max-width: 56ch;
    }

    .faq-list div {
        display: grid;
        gap: var(--space-xs);
    }

    .faq-list h3 {
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--text-primary);
    }

    .faq-list dd {
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--text-secondary);
    }
</style>
