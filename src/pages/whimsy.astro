---
import TravelMap from "../components/TravelMap.astro";
import Layout from "../layouts/Layout.astro";
import { bookSections } from "../data/books";
import { mediaSections } from "../data/movies";
import { groupTracks, musicSections } from "../data/music";
---

<Layout title="Whimsy | Aadit Agrawal">
	<section id="whimsy" class="intro">
		<h2 class="statement">Off-clock things I keep coming back to.</h2>
		<p class="intro-body">
			Places I've been, books that stuck, scores on repeat, films I admire for the craft, and other bits that don't fit a résumé.
		</p>
	</section>

	<TravelMap />

	<section id="books" class="section">
		<h2 class="section-title">books</h2>

		<div class="book-clusters">
			{bookSections.map((section) => (
				<div class:list={["book-cluster", { "book-cluster--wide": section.wide }]}>
					<h3 class="book-cluster__label font-mono">{section.label}</h3>
					{section.inline ? (
						<p class="book-cluster__inline">
							{section.books.map((book, index) => (
								<>
									{index > 0 && <span class="book-cluster__sep" aria-hidden="true">·</span>}
									<span class="book-cluster__title">{book.title}</span>
								</>
							))}
						</p>
					) : (
						<ul class="book-list">
							{section.books.map((book) => (
								<li class="book-list__item">
									<span class="book-list__title">{book.title}</span>
									{book.author && (
										<span class="book-list__author font-mono">{book.author}</span>
									)}
									{book.note && <span class="book-list__note">{book.note}</span>}
								</li>
							))}
						</ul>
					)}
				</div>
			))}
		</div>
	</section>

	<section id="films" class="section">
		<h2 class="section-title">films &amp; series</h2>
		<p class="media-disclaimer">
			Not everything I've watched. Just some films and series I've seen and liked.
		</p>

		<div class="media-grid">
			{mediaSections.map((section) => (
				<div class="media-block">
					<h3 class="media-block__label font-mono">{section.label}</h3>
					<ul class="media-list">
						{section.items.map((item) => (
							<li class="media-list__item">
								<span class="media-list__title">{item.title}</span>
								{item.year && (
									<span class="media-list__year font-mono">{item.year}</span>
								)}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<section id="music" class="section">
		<h2 class="section-title">music</h2>

		<div class="music-sections">
			{musicSections.map((section) => (
				<div class="music-section">
					<h3 class="music-section__label font-mono">{section.label}</h3>
					<div class="music-groups">
						{groupTracks(section.tracks).map((group) =>
							group.kind === "album" ? (
								<div class="music-album">
									<h4 class="music-album__name font-mono">{group.album}</h4>
									<ul class="music-album__tracks">
										{group.tracks.map((track) => (
											<li class="music-track music-track--grouped">
												<span class="music-track__title">{track.title}</span>
												<span class="music-track__artist font-mono">{track.artist}</span>
											</li>
										))}
									</ul>
								</div>
							) : (
								<article class="music-track">
									<h4 class="music-track__title">{group.track.title}</h4>
									<p class="music-track__meta font-mono">
										{group.track.artist}
										{group.track.album && (
											<span class="music-track__album">{group.track.album}</span>
										)}
									</p>
								</article>
							),
						)}
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>
	.intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		max-width: 52ch;
	}

	.statement {
		font-size: clamp(1.625rem, 4vw, 2.25rem);
		line-height: 1.2;
		letter-spacing: -0.025em;
		max-width: 22ch;
	}

	.intro-body {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--text-secondary);
	}

	.book-clusters {
		display: grid;
		gap: var(--space-lg);
	}

	@media (min-width: 640px) {
		.book-clusters {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-2xl);
			row-gap: var(--space-lg);
		}

		.book-cluster:first-child {
			grid-column: 1 / -1;
		}

		.book-cluster--wide {
			grid-column: 1 / -1;
		}
	}

	.book-cluster__label {
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--text-disabled);
		margin-bottom: var(--space-xs);
	}

	.book-cluster__inline {
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--text-secondary);
	}

	.book-cluster__title {
		color: var(--text-primary);
	}

	.book-cluster__sep {
		margin-inline: 0.35em;
		color: var(--text-disabled);
	}

	.book-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.book-list__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-xs) var(--space-lg);
		align-items: baseline;
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.book-list__title {
		color: var(--text-primary);
	}

	.book-list__author {
		font-size: 0.6875rem;
		letter-spacing: 0.03em;
		color: var(--text-secondary);
		white-space: nowrap;
	}

	.book-list__note {
		grid-column: 1 / -1;
		font-size: 0.8125rem;
		color: var(--text-disabled);
	}

	.music-sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-xl);
	}

	.media-grid {
		display: grid;
		gap: var(--space-xl);
	}

	.media-disclaimer {
		font-size: 0.9375rem;
		line-height: 1.65;
		color: var(--text-secondary);
		max-width: 52ch;
		margin-bottom: var(--space-lg);
	}

	@media (min-width: 640px) {
		.media-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-2xl);
		}
	}

	.media-block__label {
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--text-disabled);
		margin-bottom: var(--space-sm);
	}

	.media-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.media-list__item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-xs) var(--space-md);
		align-items: baseline;
		font-size: 0.875rem;
		line-height: 1.45;
	}

	.media-list__title {
		color: var(--text-primary);
	}

	.media-list__year {
		font-size: 0.6875rem;
		letter-spacing: 0.03em;
		color: var(--text-disabled);
		white-space: nowrap;
	}

	.music-section__label {
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--text-disabled);
		margin-bottom: var(--space-sm);
	}

	.music-groups {
		display: grid;
		gap: var(--space-md);
	}

	@media (min-width: 640px) {
		.music-groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-2xl);
			row-gap: var(--space-md);
		}
	}

	.music-track {
		display: flex;
		flex-direction: column;
		gap: var(--space-2xs);
		min-width: 0;
	}

	.music-track__title {
		font-size: 0.875rem;
		line-height: 1.4;
		color: var(--text-primary);
		font-weight: 600;
	}

	.music-track--grouped .music-track__title {
		font-weight: 400;
	}

	.music-track__meta,
	.music-track__artist {
		font-size: 0.6875rem;
		letter-spacing: 0.03em;
		line-height: 1.45;
		color: var(--text-secondary);
	}

	.music-track__album::before {
		content: "·";
		margin-inline: 0.35em;
		color: var(--text-disabled);
	}

	.music-album {
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
		min-width: 0;
	}

	.music-album__name {
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		color: var(--text-disabled);
	}

	.music-album__tracks {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.music-track--grouped {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: var(--space-xs) var(--space-md);
		align-items: baseline;
	}

	@media (max-width: 540px) {
		.book-list__item {
			grid-template-columns: 1fr;
			gap: var(--space-2xs);
		}

		.book-list__author {
			white-space: normal;
		}

		.music-track--grouped {
			grid-template-columns: 1fr;
			gap: var(--space-2xs);
		}
	}
</style>
