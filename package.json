{
  "name": "landingpage",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:portless": "portless run --force --app-port 4873 -- astro dev --host 127.0.0.1 --port 4873",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,jsx}\" --ignore-path .gitignore --no-error-on-unmatched-pattern",
    "check": "astro check",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "^7.4.4",
    "cobe": "^2.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@oxlint/plugins": "^1.90.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "opentype.js": "^2.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "svg-path-properties": "^2.2.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
